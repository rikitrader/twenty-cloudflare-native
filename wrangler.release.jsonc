{
  "name": "twenty-crm-release",
  "main": "src/release/index.ts",
  "compatibility_date": "2026-06-08",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "TwentyReleaseContainer",
      "image": "./Dockerfile.production",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASE_CONTAINER",
        "class_name": "TwentyReleaseContainer"
      },
      {
        "name": "STATE_DO",
        "class_name": "TwentyState",
        "script_name": "twenty-crm"
      },
      {
        "name": "SCHEDULER_DO",
        "class_name": "TwentyScheduler",
        "script_name": "twenty-crm"
      },
      {
        "name": "PUBSUB_DO",
        "class_name": "TwentyPubSub",
        "script_name": "twenty-crm"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TwentyReleaseContainer"]
    }
  ],
  "services": [
    {
      "binding": "PRODUCTION",
      "service": "twenty-crm",
      "entrypoint": "ReleaseControlService"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "ac46e11f30d14c309665848cefd7f9ce"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "twenty-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "twenty-ops",
      "database_id": "8bb23c45-a6b4-4397-952f-4a3286c52f9a"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "twenty-events" },
      { "binding": "JOBS_QUEUE", "queue": "twenty-jobs" },
      { "binding": "JOBS_DLQ", "queue": "twenty-jobs-dlq" }
    ]
  },
  "workflows": [
    {
      "binding": "RELEASE_WF",
      "name": "twenty-release",
      "class_name": "TwentyReleaseWorkflow"
    }
  ],
  "vars": {
    "SERVER_URL": "https://twenty-crm.rikitrader.workers.dev"
  },
  "observability": { "enabled": true }
}
